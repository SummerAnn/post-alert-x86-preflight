{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["artifact", "arm", "model", "rep", "active", "durable", "legitimate", "collateral", "valid"],
  "properties": {
    "artifact": {"type": "string"},
    "arm": {"enum": ["positive", "rollback", "targeted", "guided"]},
    "model": {"type": "string"},
    "rep": {"type": "integer", "minimum": 0},
    "active": {"type": "boolean"},
    "durable": {"type": "boolean"},
    "legitimate": {"type": "boolean"},
    "collateral": {"type": "boolean"},
    "valid": {"type": "boolean"},
    "reactivation_event": {"type": "string"},
    "void_reason": {"type": ["string", "null"]},
    "checks": {"type": "object"}
  },
  "additionalProperties": false
}
